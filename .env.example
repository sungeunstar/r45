# ===========================================
# Vercel Environment Variables 설정 가이드
# ===========================================
#
# 아래 내용을 Vercel Dashboard에 그대로 복사-붙여넣기 하세요:
# 1. Vercel 프로젝트 → Settings → Environment Variables
# 2. 각 변수를 하나씩 추가 (Key = 변수명, Value = 값)
# 3. Environment: Production, Preview, Development 모두 체크
#
# ===========================================

# Supabase URL
# Key: NEXT_PUBLIC_SUPABASE_URL
# Value: https://oybudjvjysnxpszgeguo.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://oybudjvjysnxpszgeguo.supabase.co

# Supabase Anonymous Key
# Key: NEXT_PUBLIC_SUPABASE_ANON_KEY
# Value: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im95YnVkanZqeXNueHBzemdlZ3VvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjMwMjM4OTAsImV4cCI6MjA3ODU5OTg5MH0.w9NFDuSkbE0-REr39dFkgj8aqiqM8s117UFPb8IFiGc
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im95YnVkanZqeXNueHBzemdlZ3VvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjMwMjM4OTAsImV4cCI6MjA3ODU5OTg5MH0.w9NFDuSkbE0-REr39dFkgj8aqiqM8s117UFPb8IFiGc

# Session Secret (32자 이상의 랜덤 문자열 생성 필요)
# Key: SESSION_SECRET
# Value: (아래 링크에서 생성) https://generate-secret.vercel.app/32
SESSION_SECRET=change-this-to-a-random-32-character-string-for-production
